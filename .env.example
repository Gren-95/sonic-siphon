# Sonic Siphon configuration. Copy to `.env` and edit.
# All values are optional; the server runs without auth if creds are unset.

# --- Authentication ---------------------------------------------------------
# Set both ADMIN_USERNAME and ADMIN_PASSWORD to require login.
# Leave one or both blank to disable auth entirely (default for local dev).
# Auth is session-cookie based; credentials are sent over HTTP, so put the
# server behind TLS (or a reverse proxy) before exposing it publicly.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- API documentation visibility -------------------------------------------
# When auth is enabled, controls whether the OpenAPI spec, Swagger-style docs,
# and JSON schemas are reachable without logging in.
# Accepted: 1/true/yes/on  or  0/false/no/off
# Default: true (open) — flip to false to require auth for /api/v1/docs etc.
PUBLIC_DOCS=true

# --- Cookie security --------------------------------------------------------
# Set to true when serving over HTTPS (directly, or behind a TLS-terminating
# reverse proxy). Adds the Secure flag to the session cookie so browsers
# refuse to send it over plain HTTP. Default false to keep local dev working.
COOKIE_SECURE=false

# --- Reverse-proxy / client-IP trust ----------------------------------------
# Comma-separated list of proxy IPs (or CIDRs) whose X-Forwarded-For header
# will be trusted for c.ClientIP() (used by the login rate limiter).
# Default: 127.0.0.1,::1 — i.e., only loopback. Set this to your proxy's IP
# (e.g. "10.0.0.5" or "172.18.0.0/16") when running behind nginx/Caddy/etc.
# An empty value falls back to the default loopback-only list.
TRUSTED_PROXIES=
